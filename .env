# Database
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Server
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=0

# Eureka
EUREKA_DEFAULT_ZONE=http://discovery:8761/eureka/
EUREKA_PREFER_IP_ADDRESS=true

# App
DEPLOY_MARKER=planwith-fo-schedule-deploy-v1
SWAGGER_SERVER_URL=/

# Schedule
SCHEDULE_GATEWAY_AUTH_ENABLED=true

# AI
AI_OPENAI_TOKENS_PER_PRODUCT_TOKEN=1000
AI_USAGE_REPORT_ENABLED=true
AI_USAGE_REPORT_TOPIC=planwith.ai-usage.reported
AI_USAGE_REPORT_RELAY_BATCH_SIZE=50
AI_USAGE_REPORT_RELAY_INTERVAL=5s
AI_USAGE_REPORT_RELAY_INITIAL_DELAY=5s
AI_USAGE_REPORT_SEND_TIMEOUT=10s
AI_USAGE_REPORT_INITIAL_RETRY_DELAY=5s
AI_USAGE_REPORT_MAX_RETRY_DELAY=5m

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_SEARCH_MODEL=gpt-5.6
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CONNECT_TIMEOUT_MILLIS=5000
OPENAI_READ_TIMEOUT_MILLIS=60000

# AviationStack
AVIATIONSTACK_ENABLED=true
AVIATIONSTACK_ACCESS_KEY=
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1
AVIATIONSTACK_CONNECT_TIMEOUT_MILLIS=5000
AVIATIONSTACK_READ_TIMEOUT_MILLIS=10000

# Flight Recommendation Cache
FLIGHT_RECOMMENDATION_CACHE_ENABLED=true
FLIGHT_RECOMMENDATION_CACHE_TTL=10m
FLIGHT_RECOMMENDATION_CACHE_KEY_PREFIX=flight:recommendation
